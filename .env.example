# Copier en .env.local et remplir avec les vraies valeurs (jamais commité).
# Sur Vercel : Project Settings > Environment Variables (mêmes noms).

# Dashboard Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé SECRET (serveur uniquement, jamais préfixée NEXT_PUBLIC_). Elle contourne
# la RLS : c'est ce qui donne à l'admin accès à toutes les tables. Ne la mettez
# que dans .env.local et dans les variables Vercel, nulle part ailleurs.
SUPABASE_SECRET_KEY=
